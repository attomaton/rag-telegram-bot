# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Claude: ключ из console.anthropic.com (или `ant auth login` — тогда ключ не нужен)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high — глубина размышлений; для консультаций по каталогу хватает low
CLAUDE_EFFORT=low
# false — бот отвечает списком найденных товаров, без LLM
USE_LLM=true

# Векторная БД: chroma | pgvector
VECTOR_STORE=chroma
CHROMA_PATH=./chroma_db
PG_DSN=postgresql://rag:rag@localhost:5432/rag

# Куда скачивать модели (по умолчанию ./.hf_cache)
# HF_HOME=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=5
MIN_SCORE=0.81

# Реранкер: пусто — выключен
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=20
RERANK_MIN_SCORE=0.01
RERANK_RELATIVE=0.1
